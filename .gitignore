# Environment variables and credentials
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# macOS and editors
.DS_Store
.vscode/
.idea/

# Model data
**/00_Data/*
!**/00_Data/.gitkeep

# Model results
**/01_Results/*
!**/01_Results/.gitkeep

# Logs and temporary files
*.log
tmp/
temp/

# Model artifacts
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt
*.onnx

# Large data files
*.parquet
*.feather
*.db
*.sqlite
*.sqlite3

# Clinical Validation contains deterministic, explicitly synthetic technical fixtures.
# Real/dev/stg/release evidence and all run results remain ignored.
!clinical_validation_model/00_Data/fixtures/
!clinical_validation_model/00_Data/fixtures/**
!clinical_validation_model/00_Data/fixtures/**/*.parquet

# Local backup archives and pptx inspection dumps (derived artifacts)
*_backup_*.tar.gz
*.inspect.ndjson
